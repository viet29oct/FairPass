# ===== Server =====
PORT=4000
# URL công khai của BE (dùng cho file upload ở chế độ local)
PUBLIC_URL=http://localhost:4000
# Origin FE được phép gọi API
CORS_ORIGIN=http://localhost:5173
# Bí mật ký token đăng nhập ví (đổi thành chuỗi ngẫu nhiên dài)
JWT_SECRET=change-me

# ===== Database =====
# docker compose (cổng 5433):
DATABASE_URL=postgresql://fairpass:fairpass@localhost:5433/fairpass?schema=public

# ===== Blockchain =====
# Local: http://127.0.0.1:8545 + CHAIN_ID=31337
# Sepolia: https://eth-sepolia.g.alchemy.com/v2/<KEY> + CHAIN_ID=11155111
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Bỏ trống → lấy từ src/contracts/addresses.json (do scripts/deploy.js ghi ra)
CONTRACT_ADDRESS=
START_BLOCK=
# Số block chờ xác nhận trước khi index (local: 0, Sepolia: 2)
CONFIRMATIONS=0
POLL_INTERVAL_MS=3000
# Số block mỗi lần gọi eth_getLogs (giảm xuống nếu RPC giới hạn)
LOG_CHUNK_SIZE=2000

# ===== IPFS / Pinata =====
# Bỏ trống → chế độ local: file lưu ở backend/uploads, phục vụ qua /uploads
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
